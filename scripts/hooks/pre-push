#!/bin/sh
# Refuse to push unless the minor version in src/setlistarr/__init__.py went up by exactly one
# compared with what the remote already has. Enable once per clone:
#   git config core.hooksPath scripts/hooks
VERSION_FILE=src/setlistarr/__init__.py
ZERO=0000000000000000000000000000000000000000

version_at() {
  git show "$1:$VERSION_FILE" 2>/dev/null | sed -n 's/^__version__ = "\(.*\)"/\1/p'
}

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in refs/tags/*) continue ;; esac   # tags ride along with their commit
  [ "$local_sha" = "$ZERO" ] && continue                # deleting a remote branch
  [ "$remote_sha" = "$ZERO" ] && continue               # first push of a new branch
  git cat-file -e "$remote_sha" 2>/dev/null || { echo "pre-push: fetch first (remote has commits you don't)"; exit 1; }

  new=$(version_at "$local_sha"); old=$(version_at "$remote_sha")
  new_major=${new%%.*}; old_major=${old%%.*}
  new_minor=$(echo "$new" | cut -d. -f2); old_minor=$(echo "$old" | cut -d. -f2)
  if [ "$new_major" = "$old_major" ] && [ "$new_minor" -eq $((old_minor + 1)) ] 2>/dev/null; then
    continue
  fi
  if [ "$new_major" -gt "$old_major" ] 2>/dev/null; then
    continue   # a deliberate major release resets the minor
  fi
  echo "pre-push: version must go from $old to $old_major.$((old_minor + 1)).0 (found $new)." >&2
  echo "          Bump __version__ in $VERSION_FILE, commit, and push again." >&2
  status=1
done
exit $status
