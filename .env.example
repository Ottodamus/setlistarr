# Local dev only (the container reads its env from docker-compose.yml).
# Everything except the bootstrap vars can also be set in the Settings UI;
# a value set here pins it and makes the UI field read-only.

# --- bootstrap ---------------------------------------------------------
SETLISTARR_CONFIG_DIR=./config
SETLISTARR_PORT=8787
LOG_FORMAT=console
# SETLISTARR_SECRET_KEY=        # generated into $CONFIG_DIR/secret_key if unset
# SETLISTARR_COOKIE_SECURE=false
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# SETLISTARR_AUTH_DISABLED=1   # handy for local dev

# --- pinned settings (optional) ---------------------------------------
# PLEX_URL=http://192.168.0.x:32400
# PLEX_TOKEN=
# LASTFM_API_KEY=
# MUSICBRAINZ_CONTACT=you@example.com
